# Copy to `.dev.vars` (gitignored) for local `wrangler pages dev`.
OPENROUTER_API_KEY=sk-or-your-key-here
# must be a tool-calling model - /ask binds tools on its first pass
MODEL=mistralai/mistral-small-3.2-24b-instruct
# optional: a classic PAT with no scopes is enough for public repos.
# Without it, GitHub reads still work at 60 requests/hour per edge IP.
GITHUB_TOKEN=
